  },
  "scripts": {
    "// start (local-only, revert before PR)": "NODE_OPTIONS=--use-system-ca makes Node trust the macOS system CA store, needed on networks that SSL-inspect traffic (e.g. campus VPN) so the /api proxy to https://minmod.isi.edu doesn't fail with UNABLE_TO_VERIFY_LEAF_SIGNATURE. Restore the line below before opening a PR.",
    "start": "NODE_OPTIONS=--use-system-ca react-scripts start",
    "_start_original": "react-scripts start",
    "build": "python ./scripts/build.py ../minmod_editor/www",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@types/lodash": "^4.17.13",
    "@types/react-highlight-words": "^0.20.0"
  }
}

